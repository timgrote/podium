# Local-only Conductor configuration. Copy to .env only when additional integrations are needed.
# The canonical local launcher exports this value itself; do not point it at production.
CONDUCTOR_DATABASE_URL=postgresql://conductor:conductor@127.0.0.1:5432/conductor_dev
CONDUCTOR_PORT=3100

# Keep external integration credentials out of source control.
# CONDUCTOR_GOOGLE_SERVICE_ACCOUNT_PATH=
# CONDUCTOR_LOKI_API_KEY=
# CONDUCTOR_KEYGEN_API_TOKEN=
